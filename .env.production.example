# ========================================
# PRODUCTION Environment Variables
# Para Hetzner - Cambiar valores según sea necesario
# ========================================

# ========== FRONTEND ==========
# Cambiar a tu dominio en Hetzner
VITE_API_URL=https://api.tudominio.com
VITE_APP_NAME=Inventory Pro App

# ========== BACKEND ==========
# Para Docker, la DB está en el servicio 'db'
DATABASE_URL=postgresql://admin:tu_password_seguro@db:5432/inventory_app?schema=public

# Puerto del servidor (en Docker, quedará en 3000 internamente)
PORT=3000

# Cambiar a una clave segura para producción
# Puedes generar una con: openssl rand -hex 32
SECRET_KEY=tu_secreto_muy_seguro_minimo_32_caracteres

# CORS para producción (cambiar * por tu dominio)
CORS_ORIGIN=https://tudominio.com

# Ambiente
NODE_ENV=production
