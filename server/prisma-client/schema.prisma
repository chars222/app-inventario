generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client" // Verifica si esta ruta es correcta para tu estructura de carpetas
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. EL NEGOCIO (La entidad principal)
model Business {
  id        Int      @id @default(autoincrement())
  name      String // Ej: "CENTRAL", "Modas Juanita"
  createdAt DateTime @default(now())

  // Un negocio tiene muchos usuarios, productos y ventas
  users    User[]
  products Product[]
  sales    Sale[]
}

// --- MODELO DE USUARIO ---
model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  fullName     String
  role         String @default("OWNER") // "OWNER" (Dueño) o "SELLER" (Vendedor)

  // Relación: El usuario pertenece a un Negocio
  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  // Un usuario realiza ventas (Auditoría: saber quién vendió)
  sales           Sale[]
  createdAt       DateTime  @default(now())
  // RELACIONES DE AUDITORÍA (Nombres explícitos)
  createdProducts Product[] @relation("CreatedBy")
  updatedProducts Product[] @relation("UpdatedBy")
  // Relaciones: Un usuario tiene muchos productos y muchas ventas
}

// --- MODELO DE CATEGORÍA ---
model Category {
  id      Int    @id @default(autoincrement())
  name    String
  iconKey String

  // NUEVO CAMPO: Define qué escala usa (LETTER, NUMERIC, SHOES)
  sizeType String @default("LETTER")

  products Product[]
}

// --- MODELO DE PRODUCTO (Maestro) ---
model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float // Precio base
  color     String   @default("Blue") // <--- NUEVO CAMPO
  // 1. FECHAS AUTOMÁTICAS (Prisma se encarga solo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // <--- Se actualiza sola cada vez que tocas el registro

  // 2. ¿QUIÉN LO CREÓ? (Obligatorio)
  createdById Int
  createdBy   User @relation("CreatedBy", fields: [createdById], references: [id])

  // 3. ¿QUIÉN LO MODIFICÓ? (Opcional, puede ser null al principio)
  updatedById Int?
  updatedBy   User?    @relation("UpdatedBy", fields: [updatedById], references: [id])
  // Relación: Producto pertenece al Negocio (NO al usuario específico)
  businessId  Int
  business    Business @relation(fields: [businessId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  variations Variation[]
}

// --- MODELO DE VARIACIÓN (Tallas y Stock) ---
model Variation {
  id    Int    @id @default(autoincrement())
  size  String // "S", "M", "L", "XL"
  stock Int    @default(0)

  // Relación con Producto
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Relación con los items vendidos
  saleItems SaleItem[]
}

// --- MODELO DE VENTA (Cabecera) ---
model Sale {
  id    Int      @id @default(autoincrement())
  total Float
  date  DateTime @default(now())

  businessId Int
  business   Business @relation(fields: [businessId], references: [id])

  // ¿Quién hizo la venta?
  userId Int
  user   User @relation(fields: [userId], references: [id])

  items SaleItem[]
}

// --- MODELO DE DETALLE DE VENTA (Filas) ---
model SaleItem {
  id       Int   @id @default(autoincrement())
  quantity Int
  price    Float // Precio al momento de la venta

  // Relación con la Venta Padre
  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id])

  // Relación con la Variación vendida (Talla específica)
  variationId Int
  variation   Variation @relation(fields: [variationId], references: [id])
}
